# Copy this file to `.env` (same directory) to have `main.rs` pick it up
# automatically on every launch — see `main.rs::main`'s `dotenvy::dotenv()`
# call and `build_ai_backend`'s doc comment for the full selection order.
# `.env` itself is gitignored; this example file is the tracked template.

# Local Ollama backend (checked first). Leave unset to fall back to
# SAFESHELL_AI_ENDPOINT below, or to NullBackend if neither is set.
SAFESHELL_OLLAMA_MODEL=llama3.2:latest
# SAFESHELL_OLLAMA_ENDPOINT=http://localhost:11434
# SAFESHELL_OLLAMA_TIMEOUT_MS=30000

# Remote HTTP backend (used only if SAFESHELL_OLLAMA_MODEL is unset).
# SAFESHELL_AI_ENDPOINT=https://example.com/ai
# SAFESHELL_AI_API_KEY=
