# Copy this file to `.env` in the repository root (same directory as
# docker-compose.yml) before running `docker compose up`. `.env` itself is
# gitignored; this example is the tracked template.
#
# This is a SEPARATE mechanism from `src-tauri/.env.example` — that one is
# read directly by the SafeShell binary itself (`main.rs`'s `dotenvy`
# call) when running it natively outside Docker. This one is read by
# `docker compose` to fill in `${VAR}` references in docker-compose.yml,
# which then injects the same variable names into the container's real
# environment. Same variables, same meaning, two different delivery
# mechanisms depending on how you're running SafeShell.

# ---- AI backend (docs/architecture.md §21.10) ----
# The model tag `docker compose exec ollama ollama pull <model>` must be
# run once after first startup (see docs/deployment.md — never
# auto-downloaded during `docker compose build`/`up`, and never baked into
# any image layer). Leave SAFESHELL_OLLAMA_MODEL empty to run with the AI
# disabled entirely (NullBackend) — SafeShell is fully functional without
# it; only the AI's advisory explanations are unavailable.
SAFESHELL_OLLAMA_MODEL=llama3.2:latest

# Only override if you want the `ageis` container to talk to an Ollama
# instance other than the bundled `ollama` Compose service (e.g. a
# GPU-equipped Ollama running elsewhere on your network). Leave commented
# out to use the internal Docker network default (http://ollama:11434).
# SAFESHELL_OLLAMA_ENDPOINT=http://ollama:11434

# Milliseconds. 30000 matches OllamaBackend's own compiled-in default
# (local model generation is slower than a hosted API round trip).
# SAFESHELL_OLLAMA_TIMEOUT_MS=30000

# ---- Ports (all bound to 127.0.0.1 by default — see docker-compose.yml) ----
# Where to reach the SafeShell GUI in your browser: http://localhost:6080
NOVNC_PORT=6080
# Where the bundled Ollama's own HTTP API is reachable from the host, if
# you want to run `ollama` CLI commands against it directly instead of via
# `docker compose exec`.
OLLAMA_PORT=11434

# ---- VNC access ----
# Leave empty for no VNC/noVNC password (fine as long as NOVNC_PORT stays
# bound to 127.0.0.1 — anyone with a shell on this machine could still
# connect, but nothing is exposed off-host). Set this if you ever change
# docker-compose.yml to publish NOVNC_PORT beyond localhost.
VNC_PASSWORD=

# ---- Display ----
# WIDTHxHEIGHTxDEPTH for the virtual X display SafeShell's window renders
# into. The default comfortably fits the app's configured window size
# (src-tauri/tauri.conf.json: 1360x860, min 960x600).
SCREEN_GEOMETRY=1440x900x24
