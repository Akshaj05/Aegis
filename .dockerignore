# Keeps the Docker build context (repo root — see docker-compose.yml's
# `build.context: .`) small and avoids ever copying secrets or local build
# output into an image layer. The Dockerfile COPYs only the specific
# directories it needs (policies/, simulated-root-image/, src-tauri/,
# frontend/), so most of this is defense in depth rather than load-bearing
# — but .env matters: without it here, a stray `COPY . .` anywhere would
# risk baking secrets into an image layer.

.git/
.github/
docs/
demo/
tests/

# Never ship into a build context or image.
.env
.env.*
!.env.example

# Rebuilt inside the image; a stale host-side target/ would be both
# useless (wrong libc/arch is not the concern here, staleness is) and
# enormous to copy into the build context.
src-tauri/target/
src-tauri/gen/schemas/*.lock

# Rebuilt from package.json inside the frontend build stage.
frontend/node_modules/
frontend/dist/

# Local databases / session state — never part of the image.
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# OS / editor cruft.
.DS_Store
*.swp
.vscode/
.idea/
